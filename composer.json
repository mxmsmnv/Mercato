{
    "name": "mxmsmnv/mercato",
    "description": "ProcessWire-native ecommerce module with reproducible runtime dependencies.",
    "type": "processwire-module",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "ext-filter": "*",
        "ext-hash": "*",
        "ext-json": "*",
        "ext-session": "*",
        "stripe/stripe-php": "^17.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "config": {
        "allow-plugins": {},
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "autoload": {
        "classmap": [
            "src/",
            "gateways/"
        ]
    },
    "scripts": {
        "test:unit": "@php scripts/run-tests.php --unit",
        "verify:runtime": "@php scripts/verify-runtime.php",
        "check:licenses": "@php scripts/check-licenses.php",
        "check:security": "composer audit --locked --no-dev"
    },
    "support": {
        "issues": "https://github.com/mxmsmnv/Mercato/issues",
        "source": "https://github.com/mxmsmnv/Mercato"
    }
}
